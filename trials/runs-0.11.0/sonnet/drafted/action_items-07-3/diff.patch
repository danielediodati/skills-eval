 def _key(text: str) -> str:
     return " ".join(text.split()).casefold()
+
+
+def _named_in(
+    name: str, clean_notes: str, attendees: Sequence[str]
+) -> Optional[str]:
+    """The name as spelled in the notes, if someone outside the meeting is named there."""
+    name = " ".join(name.split())
+    if _key(name) in _EMPTY:
+        return None
+    words = set(_key(name).split())
+    if any(words <= set(_key(a).split()) for a in attendees):
+        return None  # part of an attendee's name, e.g. a first name: ambiguous
+
+    found = re.search(rf"(?<!\w){re.escape(name)}(?!\w)", clean_notes, re.IGNORECASE)
+    return found.group(0) if found else None
 
 
