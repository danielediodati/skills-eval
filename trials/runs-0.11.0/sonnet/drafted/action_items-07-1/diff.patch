+def _name_in_notes(text: str, notes: str) -> Optional[str]:
+    """A full name (two words or more) of someone absent, as the notes spell it."""
+    name = " ".join(text.split())
+    if _key(name) in _EMPTY or " " not in name:
+        return None
+    pattern = r"\b" + r"\s+".join(re.escape(word) for word in name.split()) + r"\b"
+    found = re.search(pattern, notes, re.IGNORECASE)
+    return " ".join(found.group().split()) if found else None
 
 
