+class ChatOpenRouter(ChatOpenAI):
+    """`ChatOpenAI` on OpenRouter, whose `json_schema` output is strict unless the caller says otherwise."""
+
+    def with_structured_output(
+        self, schema: Any = None, *, method: str = "json_schema", **kwargs: Any
+    ) -> Any:
+        # ChatOpenAI sends `strict: false` for a dict schema, and strict
+        # decoding is what holds an emitted id to the schema's enum.
+        if method == "json_schema":
+            kwargs.setdefault("strict", True)
+        return super().with_structured_output(schema, method=method, **kwargs)  # type: ignore[arg-type]
+
+
+def openrouter_model(named: str | None = None) -> ChatOpenRouter:
+    """The OpenRouter chat model the environment names, or another OpenRouter serves."""
+    key = os.environ.get(OPENROUTER_KEY_ENV)
+    if not key:
+        raise ModelError(NO_OPENROUTER_CREDENTIALS)
+    return ChatOpenRouter(
+        model=named or openrouter_model_name(),
+        api_key=SecretStr(key),
