+def openrouter_models(key: str) -> dict[str, set[str]]:
+    """Every model OpenRouter serves, with the request parameters each supports."""
+    listed = openai.OpenAI(api_key=key, base_url=OPENROUTER_URL).models.list().data
+    return {
+        model.id: set(getattr(model, "supported_parameters", None) or ())
+        for model in listed
+    }
+
+
+def _openrouter_ready(on: Chat) -> None:
+    """The model OpenRouter serves under that name with strict output, or the state that says not."""
+    key = os.environ.get(OPENROUTER_KEY_ENV)
+    if not key:
+        raise ModelError(NO_OPENROUTER_CREDENTIALS)
+    try:
+        served = openrouter_models(key)
+    except Exception as error:
+        raise ModelError(f"OpenRouter cannot be reached ({error})") from error
+    setting = on.setting or OPENROUTER_MODEL_ENV
+    if on.name not in served:
+        # The list is hundreds long, so the fix points at the page instead.
+        raise ModelError(
+            f"OpenRouter does not serve {on.name}; set {setting} to "
+            f"{DEFAULT_OPENROUTER_MODEL}, or leave it empty for the same, or "
+            "pick another from https://openrouter.ai/models"
+        )
+    missing = {"structured_outputs", "tools"} - served[on.name]
+    if missing:
+        raise ModelError(
+            f"OpenRouter has no provider giving {on.name} "
+            f"{' or '.join(sorted(missing))}; set {setting} to a model that has both"
+        )
+
