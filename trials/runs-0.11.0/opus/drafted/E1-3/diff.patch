+def test_an_accepted_change_replaces_the_mesocycle_and_keeps_the_count(
+    connection: sqlite3.Connection, lunging: int
+) -> None:
+    for _ in range(2):
+        performed_once(connection)
+    request = plans.changed(connection, "2026-09-22", "basta affondi")
+    offered = mesocycle_of(plan_of("Barbell_Squat"), plan_of("Standing_Military_Press"), cycles=1)
+    graph, thread = pausing(Scripted(raw=[offered.model_dump_json()]))
+    graph.invoke(planner.starting(request), thread)
+
+    final = graph.invoke(Command(resume=planner.accepted()), thread)
+
+    found = mesocycles.today(connection)
+    assert found.mesocycle == final["mesocycle"] != lunging
+    assert (found.cycle, found.cycles) == (2, 2), "one cycle done, and the one left"
+    assert "Barbell_Lunge" not in exercises_of(mesocycles.active(connection))
+
