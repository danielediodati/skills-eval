+def test_an_adaptation_turned_down_is_answered_with_another_still_adapting(
+    connection: sqlite3.Connection, lunging: int
+) -> None:
+    request = plans.adapted(connection, "2026-09-22", said="solo 30 minuti oggi")
+    first, second = plan_of("Barbell_Squat", rounds=2), plan_of("Barbell_Squat", rounds=3)
+    model = Scripted(
+        raw=[first.model_dump_json(), first.model_dump_json(), second.model_dump_json()]
+    )
+    graph, thread = pausing(model)
+    graph.invoke(planner.starting(request), thread)
+
+    final = graph.invoke(Command(resume=planner.refused("troppo")), thread)
+
+    assert final["plan"] == second, "the same plan again was refused"
+    briefed = "\n".join(message.text for message in model.seen[-1])
+    assert "solo 30 minuti oggi" in briefed and "troppo" in briefed
