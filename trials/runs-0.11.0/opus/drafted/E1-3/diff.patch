+def record_adapted(
+    connection: sqlite3.Connection,
+    blocks: Sequence[workouts.PrescribedBlock],
+    *,
+    mesocycle: int,
+    slot: int,
+    on: str,
+) -> int:
+    """Prescribe an adaptation of today's slot as that slot's serving, and return its workout id.
+
+    A serving already written stays prescribed, as a second plan in a day
+    does (`workouts.record_prescribed`); asked again, the adaptation is served.
+    """
+    if not blocks:
+        raise workouts.WorkoutError("a workout is at least one block")
+    duration.check_plan([prescribed.block for prescribed in blocks])
+
+    connection.execute("BEGIN IMMEDIATE")
+    try:
+        found = today(connection)
+        if (found.mesocycle, found.slot) != (mesocycle, slot):
+            raise MesocycleError(
+                "today's workout is no longer the one that was adapted; ask again"
+            )
+        performed = state.rotation(connection).performed
+        workout_id = workouts.write_prescribed(connection, blocks, on)
