+def test_an_accepted_adaptation_is_todays_serving_and_the_mesocycle_is_unchanged(
+    connection: sqlite3.Connection, lunging: int
+) -> None:
+    before = mesocycles.active(connection)
+    request = plans.adapted(connection, "2026-09-22", said="solo 30 minuti oggi")
+    graph, thread = pausing(Scripted(raw=[plan_of("Barbell_Squat", rounds=2).model_dump_json()]))
+    graph.invoke(planner.starting(request), thread)
+
+    final = graph.invoke(Command(resume=planner.accepted()), thread)
+
+    assert mesocycles.active(connection) == before
+    _, served = mesocycles.record_served(connection, "2026-09-22")
+    assert served == final["workout"]
+    assert [b.block.rounds for b in workouts.prescribed(connection, served)] == [2]
+
