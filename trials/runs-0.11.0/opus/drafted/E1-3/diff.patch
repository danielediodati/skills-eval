+            "INSERT INTO served (workout_id, mesocycle_id, slot, served_after) "
+            "VALUES (?, ?, ?, ?) "
+            "ON CONFLICT (mesocycle_id, served_after) DO UPDATE SET "
+            "workout_id = excluded.workout_id, slot = excluded.slot",
+            (workout_id, mesocycle, slot, performed),
+        )
+        connection.execute("COMMIT")
+    except Exception:
+        try:
+            connection.execute("ROLLBACK")
+        except sqlite3.Error:
+            pass
+        raise
+    return workout_id
