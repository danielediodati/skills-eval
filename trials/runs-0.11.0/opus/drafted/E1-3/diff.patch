+            workouts.PerformedBlock(
+                items=(
+                    workouts.PerformedItem(
+                        exercise_id="Barbell_Squat", unit="reps", amount=5, amount_source="reported"
+                    ),
+                ),
+                rounds=1,
+                rounds_source="reported",
+                rest=0,
+                rest_source="reported",
+            ),
+        ),
+        on="2026-09-22",
+        report="fatto",
+        workout_id=served,
+    )
+
+
+def exercises_of(kept_one: mesocycles.Mesocycle | None) -> set[str]:
+    assert kept_one is not None
+    return {
+        item.exercise_id
+        for blocks in kept_one.slots
+        for prescribed_block in blocks
+        for item in prescribed_block.block.items
+    }
+
