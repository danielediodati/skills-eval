+    def supersede(self, on: RunnableConfig) -> dict[str, Any] | None:
+        """The proposal pending on this thread ended unanswered, so no tap reaches it; its record, or nothing."""
+        if self.pending(on) is None:
+            return None
+        record = records.left(
+            self._planner, on, records.SUPERSEDED, self._budget, self._archive
+        )
+        # Written as `prescribe`, whose only edge is END: as `propose` the
+        # update would route on to `planner`, and a resume would plan again.
+        self._planner.update_state(
+            on, {"ending": record["ending"], "ended": record["ended"]}, as_node="prescribe"
+        )
+        return record
+
+    def lapse(self, on: RunnableConfig) -> dict[str, Any] | None:
+        """The adaptation pending on this thread superseded once the day it adapts has moved on; its record, or nothing."""
+        held = self.pending(on)
+        if held is None or not isinstance(held.request, plans.Request):
+            return None
+        adapting = held.request.adapting
+        if adapting is None:
+            return None
+        with tools.reported(), tools.opened() as connection:
+            try:
+                found = mesocycles.today(connection)
+            except mesocycles.MesocycleError:
+                return self.supersede(on)
+        if (found.mesocycle, found.performed) == (adapting.mesocycle, adapting.served_after):
+            return None
+        return self.supersede(on)
 
