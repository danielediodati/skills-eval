+def test_a_proposal_a_new_ask_replaces_is_written_as_stopped_and_followed(
+    catalogued: sqlite3.Connection, tmp_path: Path
+) -> None:
+    talks = negotiation_of(
+        Scripted(documents=[plan_of("Barbell_Squat"), plan_of("Standing_Military_Press")]),
+        tmp_path,
+    )
+    old = talks.open(PLANNING, BARBELL_45)
+    assert isinstance(old, negotiations.Proposed)
+
+    new = talks.open(PLANNING, BARBELL_45)
+
+    assert isinstance(new, negotiations.Proposed)
+    (negotiation,) = (tmp_path / "runs").iterdir()
+    (written,) = negotiation.iterdir()
+    ended = json.loads(written.read_text(encoding="utf-8"))
+    assert ended["ending"] == "stopped" and ended["plan"] is not None
+    accepted = talks.answer(PLANNING, new.id, planner.accepted())
+    assert isinstance(accepted, negotiations.Accepted)
+    assert accepted.record["negotiation"] == ended["negotiation"]
+    assert accepted.record["follows"] == ended["run"]
+
