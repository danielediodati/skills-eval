+def test_reporting_the_adapted_workout_ends_the_adaptation(
+    catalogued: sqlite3.Connection, declared: Path
+) -> None:
+    """A tap on it afterwards writes nothing, and the chat says why."""
+    graphs, front, buttons = adaptation_open(
+        catalogued,
+        adapted_of("Barbell_Squat", rounds=2, minutes=30),
+        log=logger_graph_of(
+            scripted(
+                AIMessage(content="chiaro"),
+                emits=report(report="fatto squat, 3 giri", blocks=[done("Barbell_Squat")]),
+            ),
+            checkpointer=InMemorySaver(),
+        ),
+    )
+    front.turns = [calling(entrance.LOG_WORKOUT)]
+
+    reported_back = asking(graphs, "fatto squat, 3 giri")
+    said, say = spoken()
+    asyncio.run(turns_of(graphs).tapped(OWNER, CHAT, buttons[0][0], channel(say)))
+
+    assert reported_back.said == [SAYS, entrance.LOGGED]
+    assert graphs.negotiation.pending(planning_on()) is None
+    assert said == [entrance.OVERTAKEN]
+    assert workout_states(catalogued) == ["performed"], "the adaptation was never prescribed"
+    (adaptation,) = [run for run in archived() if run["plan"] is not None]
+    assert adaptation["ending"] == run_record.STOPPED
+
