+def test_a_new_ask_over_an_open_proposal_ends_it_and_follows_it(
+    catalogued: sqlite3.Connection, declared: Path
+) -> None:
+    """The proposal ends when it is replaced, as stopped, and is never left reading as cut."""
+    graphs, front, buttons = adaptation_open(
+        catalogued,
+        adapted_of("Barbell_Squat", rounds=2, minutes=30),
+        adapted_of("Barbell_Squat", rounds=1, minutes=20),
+    )
+    front.turns = [calling(entrance.ADAPT_THIS_WORKOUT, said="ho 20 minuti")]
+
+    ((text, _),) = asking(graphs, "ho 20 minuti").offers
+    said, say = spoken()
+    asyncio.run(turns_of(graphs).tapped(OWNER, CHAT, buttons[0][0], channel(say)))
+
+    assert "20" in text
+    assert said == [entrance.SUPERSEDED]
+    assert workout_rows(catalogued) == []
+    (first,) = [run for run in archived() if run["plan"] is not None]
+    assert first["ending"] == run_record.STOPPED
+    assert graphs.negotiation.pending(planning_on()) is not None, "the new one is offered"
+    following = graphs.planner.get_state(planning_on()).values
+    assert following["negotiation"] == first["negotiation"]
+    assert following["follows"] == first["run"]
+
