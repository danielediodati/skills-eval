+def test_a_change_continues_the_cycle_count(
+    connection: sqlite3.Connection, two_slots: Path
+) -> None:
+    """ADR-0008 item 6: a change rewrites the cycles left, not the ones done."""
+    accepted(connection)
+    for _ in range(3):
+        _, served = mesocycles.record_served(connection, TODAY)
+        performed(connection, served)
+
+    changed = mesocycles.record_change(
+        connection, (slot("Plank"), slot("Barbell_Squat")), cycles=2, why="no squats first", on=TODAY
+    )
+
+    found = mesocycles.today(connection)
+    assert (found.mesocycle, found.slot, found.cycle) == (changed, 2, 2)
+    assert found.blocks == slot("Barbell_Squat")
+
+
+def test_a_change_withdraws_the_old_slot_served_and_not_performed(
+    connection: sqlite3.Connection, two_slots: Path
+) -> None:
+    accepted(connection)
+    _, stale = mesocycles.record_served(connection, TODAY)
+
+    mesocycles.record_change(
+        connection, (slot("Plank"), slot("Barbell_Squat")), cycles=2, why="b", on=TODAY
+    )
+    _, served = mesocycles.record_served(connection, TODAY)
+
+    assert workouts.workout(connection, stale) is None
+    assert workouts.prescribed(connection, served) == slot("Plank")
+    assert connection.execute("SELECT COUNT(*) FROM workouts").fetchone()[0] == 1
+
+
+def test_a_change_with_nothing_to_change_is_a_state_naming_the_fix(
+    connection: sqlite3.Connection, two_slots: Path
+) -> None:
+    with pytest.raises(mesocycles.MesocycleError, match="trainer plan --mesocycle"):
+        mesocycles.record_change(connection, (slot("Plank"),), cycles=2, why="b", on=TODAY)
+    assert mesocycles.active(connection) is None
+
+
+def test_an_adaptation_is_the_slots_serving_and_leaves_the_mesocycle(
+    connection: sqlite3.Connection, two_slots: Path
+) -> None:
+    accepted(connection)
+    before = mesocycles.active(connection)
+
+    _, adapted = mesocycles.record_adapted(connection, slot("Plank", reps=10), TODAY)
+    _, served = mesocycles.record_served(connection, TODAY)
+
+    assert served == adapted
+    assert workouts.prescribed(connection, served) == slot("Plank", reps=10)
+    assert mesocycles.active(connection) == before
+
+
+def test_an_adaptation_replaces_the_unadapted_serving(
+    connection: sqlite3.Connection, two_slots: Path
+) -> None:
+    accepted(connection)
+    _, unadapted = mesocycles.record_served(connection, TODAY)
+
+    _, adapted = mesocycles.record_adapted(connection, slot("Plank", reps=10), TODAY)
+
+    assert workouts.workout(connection, unadapted) is None
+    assert workouts.awaiting(connection) == workouts.workout(connection, adapted)
+
+
+def test_a_performed_adaptation_moves_the_rotation_on(
+    connection: sqlite3.Connection, two_slots: Path
+) -> None:
+    accepted(connection)
+    _, adapted = mesocycles.record_adapted(connection, slot("Plank", reps=10), TODAY)
+    performed(connection, adapted)
+
+    found, _ = mesocycles.record_served(connection, TODAY)
+
+    assert found.slot == 2
