+def record_adapted(
+    connection: sqlite3.Connection, blocks: Sequence[workouts.PrescribedBlock], on: str
+) -> tuple[Today, int]:
+    """Prescribe an adapted workout as today's serving of its slot, and return its workout id.
+
+    A serving of the slot not yet performed is withdrawn; the mesocycle is untouched.
+    """
+    if not blocks:
+        raise workouts.WorkoutError("a workout is at least one block")
+    duration.check_plan([prescribed.block for prescribed in blocks])
+
+    connection.execute("BEGIN IMMEDIATE")
+    try:
+        found = today(connection)
+        performed = state.rotation(connection).performed
+        _withdraw_serving(connection, found.mesocycle, performed)
+        workout_id = workouts.write_prescribed(connection, blocks, on)
+        connection.execute(
+            "INSERT INTO served (workout_id, mesocycle_id, slot, served_after) "
+            "VALUES (?, ?, ?, ?)",
+            (workout_id, found.mesocycle, found.slot, performed),
+        )
+        connection.execute("COMMIT")
+    except Exception:
+        try:
+            connection.execute("ROLLBACK")
+        except sqlite3.Error:
+            pass
+        raise
+    return found, workout_id
+
+
+def _withdraw_serving(connection: sqlite3.Connection, mesocycle_id: int, performed: int) -> None:
+    """Delete the slot's serving at this count if it is still only prescribed; its rows cascade."""
+    connection.execute(
+        "DELETE FROM workouts WHERE state = 'prescribed' AND id IN "
+        "(SELECT workout_id FROM served WHERE mesocycle_id = ? AND served_after = ?)",
+        (mesocycle_id, performed),
+    )
