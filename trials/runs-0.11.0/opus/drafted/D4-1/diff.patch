+def adaptation_offered(
+    catalogued: sqlite3.Connection, archive: Path, *plans_offered: plans.WorkoutPlan
+) -> tuple[bot.Graphs, Talking, list[tuple[str, str]]]:
+    """Today's workout served, an adaptation of it offered, and the buttons it came with."""
+    mesocycles.record_mesocycle(
+        catalogued,
+        tuple(
+            tuple(
+                workouts.PrescribedBlock(block=block, reason=shape.reason)
+                for shape, block in zip(workout.blocks, plans.to_blocks(workout), strict=True)
+            )
+            for workout in A_MESOCYCLE.workouts
+        ),
+        cycles=A_MESOCYCLE.cycles,
+        why=A_MESOCYCLE.why,
+        on=date.today().isoformat(),
+    )
+    _, today = mesocycles.record_served(catalogued, date.today().isoformat())
+    held = InMemorySaver()
+    front = Talking(turns=[calling(entrance.ADAPT_THIS_WORKOUT, said="solo 30 minuti oggi")])
+    graphs = graphs_of(
+        graph_of(Scripted(documents=list(plans_offered)), checkpointer=held),
+        front=front,
+        log=logger_graph_of(
+            scripted(AIMessage(content="chiaro"), emits=report(workout_id=today, report="squat")),
+            checkpointer=held,
+            archive=archive,
+        ),
+        saver=held,
+        archive=archive,
+    )
+    ((_, buttons),) = asking(graphs, "solo 30 minuti oggi").offers
+    return graphs, front, buttons
+
