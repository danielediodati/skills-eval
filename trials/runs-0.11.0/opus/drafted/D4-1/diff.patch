+def superseded(
+    graph: Graph,
+    config: RunnableConfig,
+    budget: int,
+    archive: Path | None = None,
+) -> dict[str, Any]:
+    """The proposal the thread is waiting on, ended as superseded and written down; its ending."""
+    state = {**graph.get_state(config).values, "ending": SUPERSEDED, "ended": now()}
+    if archive is not None and state.get("run"):
+        keep(state, budget, archive)
+    return {"ending": state["ending"], "ended": state["ended"]}
 
 
